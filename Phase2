// Interface for discount feature
interface Discountable {
    void applyDiscount(double percentage);
}

// Abstract parent class
abstract class BaseItem implements Serializable {

    protected int id;
    protected String name;

    public BaseItem(int id, String name) {
        this.id = id;
        this.name = name;
    }

    // Abstract method
    public abstract double calculatePrice();

    // Getters
    public int getId() { return id; }

    public String getName() { return name; }
}

// Pizza class
class Pizza extends BaseItem implements Discountable {

    protected double basePrice;
    protected String size;

    public Pizza(int id, String name,
                 double basePrice, String size) {

        super(id, name);

        this.basePrice = basePrice;
        this.size = size;
    }

    // Calculate price based on size
    public double calculatePrice() {

        if (size.equalsIgnoreCase("L"))
            return basePrice + 10;

        if (size.equalsIgnoreCase("M"))
            return basePrice + 5;

        return basePrice;
    }

    // Apply discount
    public void applyDiscount(double percentage) {

        basePrice -=
                (basePrice * percentage / 100);
    }

    public String toString() {

        return "Pizza ID: " + id +
                ", Name: " + name +
                ", Price: " + calculatePrice() +
                ", Size: " + size;
    }
}

// Veggie pizza class
class VeggiePizza extends Pizza {

    private String vegetableType;

    public VeggiePizza(int id, String name,
                       double basePrice,
                       String size,
                       String vegetableType) {

        super(id, name, basePrice, size);

        this.vegetableType = vegetableType;
    }

    // Add extra price
    public double calculatePrice() {

        return super.calculatePrice() + 5;
    }

    public String toString() {

        return super.toString() +
                ", Veg: " + vegetableType;
    }
}

// Meat pizza class
class MeatPizza extends Pizza {

    private String meatType;

    public MeatPizza(int id, String name,
                     double basePrice,
                     String size,
                     String meatType) {

        super(id, name, basePrice, size);

        this.meatType = meatType;
    }

    // Add extra price
    public double calculatePrice() {

        return super.calculatePrice() + 10;
    }

    public String toString() {

        return super.toString() +
                ", Meat: " + meatType;
    }
}

// Custom exception
class PizzaNotFoundException extends Exception {

    public PizzaNotFoundException(String msg) {

        super(msg);
    }
}

// Node for linked list
class Node implements Serializable {

    Pizza data; 
    Node next; //next node

    public Node(Pizza data) {

        this.data = data;
        this.next = null;
    }
}

// Linked list class
class PizzaLinkedList implements Serializable {

    private Node head; //first node

    // Add pizza
    public void add(Pizza p) {

        Node newNode = new Node(p);

        if (head == null)

            head = newNode;

        else {

            Node current = head;

            while (current.next != null)

                current = current.next;

            current.next = newNode;
        }
    }

    // Search pizza
    public Pizza search(String name)
            throws PizzaNotFoundException {

        Node current = head;

        while (current != null) {

            if (current.data.getName()
                    .equalsIgnoreCase(name))

                return current.data;

            current = current.next;
        }

        throw new PizzaNotFoundException(
                "Pizza not found: " + name);
    }

    // Display all pizzas
    public String displayAll() {

        StringBuilder sb =
                new StringBuilder();

        Node current = head;

        while (current != null) {

            sb.append(current.data.toString())
                    .append("\n");

            current = current.next;
        }

        return sb.toString();
    }
}

// Pizza shop class
class PizzaShop implements Serializable {

    private String shopName;

    private PizzaLinkedList menu =
            new PizzaLinkedList();

    public PizzaShop(String shopName) {

        this.shopName = shopName;
    }

    // Add pizza to menu
    public void addPizza(Pizza p) {

        menu.add(p);
    }

    // Find pizza
    public Pizza findPizza(String name)
            throws PizzaNotFoundException {

        return menu.search(name);
    }

    // Show all pizzas
    public String listPizzas() {

        return menu.displayAll();
    }

    // Save data to file
    public void saveToFile(String filename)
            throws IOException {

        ObjectOutputStream oos =
                new ObjectOutputStream(
                        new FileOutputStream(filename));

        oos.writeObject(menu);

        oos.close();
    }

    // Load data from file
    public void readFromFile(String filename)
            throws IOException,
            ClassNotFoundException {

        ObjectInputStream ois =
                new ObjectInputStream(
                        new FileInputStream(filename));

        menu =
                (PizzaLinkedList) ois.readObject();

        ois.close();
    }
}

// GUI class
// GUI class
class PizzaGUI extends JFrame {

    private PizzaShop shop;

    private JTextField idField,
            nameField,
            priceField,
            sizeField,
            typeField,
            searchField;

    private JTextArea output;

    private JButton addBtn,
            searchBtn,
            saveBtn,
            loadBtn,
            discountBtn,
            displayBtn;  

    public PizzaGUI(PizzaShop shop) {

        this.shop = shop;

        setTitle("Pizza Shop System");

        setSize(600, 450);

        setDefaultCloseOperation(
                JFrame.EXIT_ON_CLOSE);

        setLayout(new BorderLayout());

        // Input panel
        JPanel inputPanel =
                new JPanel(
                        new GridLayout(6, 2, 5, 5));

        inputPanel.setBorder(
                BorderFactory
                        .createTitledBorder(
                                "Add Pizza"));

        idField = new JTextField();
        nameField = new JTextField();
        priceField = new JTextField();
        sizeField = new JTextField();
        typeField = new JTextField();

        inputPanel.add(new JLabel("ID:"));
        inputPanel.add(idField);

        inputPanel.add(new JLabel("Name:"));
        inputPanel.add(nameField);

        inputPanel.add(
                new JLabel("Base Price:"));
        inputPanel.add(priceField);

        inputPanel.add(
                new JLabel("Size (S/M/L):"));
        inputPanel.add(sizeField);

        inputPanel.add(
                new JLabel("Type (Veg/Meat):"));
        inputPanel.add(typeField);

        addBtn =
                new JButton("Add Pizza");

        discountBtn =
                new JButton("Apply Discount");

        inputPanel.add(addBtn);

        inputPanel.add(discountBtn);

        add(inputPanel,
                BorderLayout.NORTH);

        // Action panel
        JPanel actionPanel =
                new JPanel(
                        new FlowLayout());

        searchField =
                new JTextField(10);

        searchBtn =
                new JButton("Find Pizza");

        saveBtn =
                new JButton("Save to File");

        loadBtn =
                new JButton("Load from File");

        displayBtn =
                new JButton("Display All");  

        actionPanel.add(
                new JLabel("Search by Name:"));

        actionPanel.add(searchField);

        actionPanel.add(searchBtn);

        actionPanel.add(saveBtn);

        actionPanel.add(loadBtn);

        actionPanel.add(displayBtn);   

        add(actionPanel,
                BorderLayout.CENTER);

        // Output area
        output = new JTextArea();

        output.setEditable(false);

        add(new JScrollPane(output),
                BorderLayout.SOUTH);

        // Add pizza button
        addBtn.addActionListener(e -> {

            try {

                int id =
                        Integer.parseInt(
                                idField.getText());

                String name =
                        nameField.getText();

                double price =
                        Double.parseDouble(
                                priceField.getText());

                String size =
                        sizeField.getText();

                String type =
                        typeField.getText();

                Pizza p;

                if (type.equalsIgnoreCase("Veg"))

                    p = new VeggiePizza(
                            id, name,
                            price, size,
                            "Mushroom");

                else

                    p = new MeatPizza(
                            id, name,
                            price, size,
                            "Pepperoni");

                shop.addPizza(p);

                output.setText(
                        "Pizza added successfully!\n"
                                + shop.listPizzas());
            }

            catch (NumberFormatException ex) {JOptionPane.showMessageDialog(
                        this,
                        "Invalid number input!",
                        "Error",
                        JOptionPane.ERROR_MESSAGE);
            }

            catch (Exception ex) {

                JOptionPane.showMessageDialog(
                        this,
                        ex.getMessage(),
                        "Error",
                        JOptionPane.ERROR_MESSAGE);
            }
        });

        // Search button
        searchBtn.addActionListener(e -> {

            try {

                String name =
                        searchField.getText();

                Pizza found =
                        shop.findPizza(name);

                output.setText(
                        "Found:\n"
                                + found.toString());
            }

            catch (PizzaNotFoundException ex) {

                JOptionPane.showMessageDialog(
                        this,
                        ex.getMessage(),
                        "Not Found",
                        JOptionPane.WARNING_MESSAGE);
            }
        });

        // Save button
        saveBtn.addActionListener(e -> {

            try {

                shop.saveToFile("pizzas.dat");

                JOptionPane.showMessageDialog(
                        this,
                        "Data saved successfully!");
            }

            catch (IOException ex) {

                JOptionPane.showMessageDialog(
                        this,
                        "Error saving file!",
                        "Error",
                        JOptionPane.ERROR_MESSAGE);
            }
        });

        // Load button
        loadBtn.addActionListener(e -> {

            try {

                shop.readFromFile("pizzas.dat");

                output.setText(
                        "Data loaded successfully!\n"
                                + shop.listPizzas());
            }

            catch (Exception ex) {

                JOptionPane.showMessageDialog(
                        this,
                        "Error loading file!",
                        "Error",
                        JOptionPane.ERROR_MESSAGE);
            }
        });

        // Discount button
        discountBtn.addActionListener(e -> {

            try {

                String name =
                        searchField.getText();

                Pizza p =
                        shop.findPizza(name);

                String s =
                        JOptionPane
                                .showInputDialog(
                                        "Enter discount percentage:");

                if (s != null) {

                    double disc =
                            Double.parseDouble(s);

                    p.applyDiscount(disc);

                    output.setText(
                            "Discount applied!\n"
                                    + p.toString());
                }
            }

            catch (PizzaNotFoundException ex) {

                JOptionPane.showMessageDialog(
                        this,
                        ex.getMessage(),
                        "Error",
                        JOptionPane.WARNING_MESSAGE);
            }

            catch (NumberFormatException ex) {

                JOptionPane.showMessageDialog(
                        this,
                        "Invalid discount input!",
                        "Error",
                        JOptionPane.ERROR_MESSAGE);
            }
        });

        // Display All button
        displayBtn.addActionListener(e -> {

            String allPizzas =
                    shop.listPizzas();

            if (allPizzas.isEmpty())

                output.setText(
                        "No pizzas in the menu!");

            else

                output.setText(
                        "All Pizzas:\n"
                                + allPizzas);
        });

        setVisible(true);
    }
}
// Main class
public class Main {

    public static void main(String[] args) {

        PizzaShop shop =
                new PizzaShop(
                        "Slice Of Heaven");

        new PizzaGUI(shop);
    }
}
